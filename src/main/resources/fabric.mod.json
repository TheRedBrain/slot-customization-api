{
  "schemaVersion": 1,
  "id": "slotcustomizationapi",
  "version": "${version}",
  "name": "Slot Customization API",
  "description": "A small API for mods to dynamically modify inventory slots.",
  "authors": [
    "TheRedBrain"
  ],
  "contact": {
    "sources": "https://github.com/TheRedBrain/slot-customization-api"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.theredbrain.slotcustomizationapi.SlotCustomizationAPI"
    ],
    "client": [
      "com.github.theredbrain.slotcustomizationapi.SlotCustomizationAPIClient"
    ]
  },
  "mixins": [
    "slotcustomizationapi.mixins.json",
    {
      "config": "slotcustomizationapi.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "fzzy_config": ">=${fzzy_config_version}"
  }
}